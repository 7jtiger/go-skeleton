func (p *Router) handleImageCheck(c *gin.Context) {
	file, err := c.FormFile("image")
	if err != nil {
		c.JSON(http.StatusBadRequest, gin.H{"error": "이미지 업로드 실패"})
		return
	}

	// 임시 파일 저장
	tempPath := filepath.Join(os.TempDir(), file.Filename)
	if err := c.SaveUploadedFile(file, tempPath); err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{"error": "파일 저장 실패"})
		return
	}
	defer os.Remove(tempPath)

	// NSFW 검사
	detector, err := NewNSFWDetector("path/to/model")
	if err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{"error": "NSFW 검사기 초기화 실패"})
		return
	}
	defer detector.Close()

	result, err := detector.CheckImage(tempPath)
	if err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{"error": "이미지 검사 실패"})
		return
	}

	c.JSON(http.StatusOK, result)
}
